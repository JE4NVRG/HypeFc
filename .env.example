# Football Data API (opcional)
# Sem token, o dashboard usa a ESPN publica: jogos, tabela, estatistica de partida.
# Com token, jogos/tabela/artilheiros vem da Football-Data.
FOOTBALL_API_TOKEN=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4

# Loja / acesso pro (Supabase do projeto HypeFC). Sem estas duas a tela pro entra
# em modo lista de espera — nada quebra, nada promete acesso.
# A anon key e publica por desenho (vai no bundle); a service key NAO: ela fica
# so no .env.local do Mac que roda o cron (npm run record -> npm run alertas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Web Push (VAPID) — e o que entrega o alerta "seu time joga hoje".
# Gere o par uma vez: npx --yes web-push generate-vapid-keys --json
# Sem o par configurado o painel diz que os alertas estao indisponiveis e o cron
# sai sem enviar (nao inventa entrega).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email
